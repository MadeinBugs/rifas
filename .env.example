# ============================================================
#  Variáveis de ambiente — Rifa Solidária do Gatinho
#  Copie este arquivo para .env.local e preencha os valores.
#  (.env.local é ignorado pelo git — nunca comite segredos)
# ============================================================

# ── Supabase ── (Fase 1)
# Project Settings > Data API  (URL)  e  Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Mercado Pago ── (Fase 3)
# Suas Integrações > sua aplicação > Credenciais de produção
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ── Painel /admin ── (Fase 4)
ADMIN_PASSWORD=

# ── App ──
# Em produção, a URL pública (https://...). Em dev, localhost.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
